---
import { cs229Sessions, getCs229VideoUrl } from '@/utils/cs229-sessions'

const groups = [
  {
    title: '第一阶段 · 监督学习',
    description: 'P1–P10：课程导论、数学准备、回归、GLM、生成式学习、SVM 与 Kernel。',
    sessions: cs229Sessions.slice(0, 10)
  },
  {
    title: '第二阶段 · 泛化、树模型与神经网络',
    description: 'P11–P18：模型选择、学习理论、集成学习、神经网络、评估、调试与期中复习。',
    sessions: cs229Sessions.slice(10, 18)
  },
  {
    title: '第三阶段 · 无监督学习',
    description: 'P19–P22：K-means、GMM、EM、Factor Analysis、PCA、ICA 与强化学习导论。',
    sessions: cs229Sessions.slice(18, 22)
  },
  {
    title: '第四阶段 · 强化学习、控制与责任',
    description: 'P23–P28：MDP、价值迭代、连续状态、ML 批判、LQR、LQG 与 CNN 讨论课。',
    sessions: cs229Sessions.slice(22)
  }
]
---

<div class='not-prose mt-10 space-y-10' data-cs229-course-overview>
  <section class='grid gap-3 sm:grid-cols-4'>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>28</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>B 站分集 / 独立页面</span>
    </div>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>21</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>正式或原始课堂录像</span>
    </div>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>7</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>Discussion Sections</span>
    </div>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>1:1</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>视频、页面与材料映射</span>
    </div>
  </section>

  {
    groups.map((group) => (
      <section>
        <div class='mb-4'>
          <h2 class='text-lg font-semibold text-foreground'>{group.title}</h2>
          <p class='mt-1 text-sm text-muted-foreground'>{group.description}</p>
        </div>

        <ol class='grid gap-3 lg:grid-cols-2'>
          {group.sessions.map((session) => (
            <li class='rounded-2xl border border-border bg-card/70 p-4'>
              <div class='flex items-start gap-4'>
                <span class='flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-sm font-semibold text-primary'>
                  P{session.videoPage}
                </span>
                <div class='min-w-0 flex-1'>
                  <div class='flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-muted-foreground'>
                    <span>{session.label}</span>
                    {session.date && (
                      <>
                        <span aria-hidden='true'>·</span>
                        <span>{session.date}</span>
                      </>
                    )}
                    <span aria-hidden='true'>·</span>
                    <span>{session.duration}</span>
                  </div>
                  <a
                    href={`/notes/cs229/course/${session.slug}`}
                    class='mt-1 block font-medium text-foreground transition-colors hover:text-primary'
                  >
                    {session.titleZh}
                  </a>
                  <p class='mt-1 truncate text-xs text-muted-foreground'>{session.titleEn}</p>
                  <div class='mt-3 flex flex-wrap items-center gap-2 text-xs'>
                    <span class='rounded-full bg-muted px-2.5 py-1 text-muted-foreground'>
                      {session.materials.length} 份课堂材料
                    </span>
                    {session.assignment && (
                      <span class='rounded-full bg-muted px-2.5 py-1 text-muted-foreground'>
                        {session.assignment.label}
                      </span>
                    )}
                    <a
                      href={getCs229VideoUrl(session)}
                      target='_blank'
                      rel='noopener noreferrer'
                      class='ms-auto text-primary hover:underline'
                    >
                      B 站 ↗
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <section class='rounded-2xl border border-dashed border-border bg-card/40 p-5'>
    <h2 class='text-sm font-semibold text-foreground'>P21 编号说明</h2>
    <p class='mt-2 text-sm leading-6 text-muted-foreground'>
      B 站 P21 只保留了 2018-11-12 的原始录像文件名。本站依据官方课表、前后分集和 Lecture Notes 10
      将其对应为 PCA，并在课程页保留证据说明，没有伪造 Lecture 编号。
    </p>
  </section>
</div>
