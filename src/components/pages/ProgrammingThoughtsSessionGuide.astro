---
import {
  getProgrammingThoughtsChapterSessions,
  getProgrammingThoughtsDuration,
  getProgrammingThoughtsEmbedUrl,
  getProgrammingThoughtsVideoUrl,
  programmingThoughtsChapters,
  programmingThoughtsPhases
} from '@/utils/programming-thoughts-sessions'
import type { ProgrammingThoughtsChapter } from '@/utils/programming-thoughts-sessions'

interface Props { chapter: ProgrammingThoughtsChapter }
const { chapter } = Astro.props
const sessions = getProgrammingThoughtsChapterSessions(chapter)
const index = programmingThoughtsChapters.findIndex((item) => item.slug === chapter.slug)
const previous = programmingThoughtsChapters[index - 1]
const next = programmingThoughtsChapters[index + 1]
const phase = programmingThoughtsPhases.find((item) => item.id === chapter.phase)
const minutes = Math.round(sessions.reduce((sum, session) => sum + session.durationSeconds, 0) / 60)
---

<section class='not-prose mb-8 space-y-5' data-programming-thoughts-chapter={chapter.slug}>
  <div class='rounded-2xl border border-primary/20 bg-primary/[0.04] p-5'>
    <div class='flex flex-wrap items-center gap-2 text-xs font-semibold tracking-wide text-primary'>
      <span>P{chapter.startPage}–P{chapter.endPage}</span><span>·</span><span>{phase?.label}</span><span>·</span><span>约 {minutes} 分钟视频</span>
    </div>
    <h2 class='mt-3 text-lg font-semibold text-foreground'>{chapter.question}</h2>
    <p class='mt-2 text-sm leading-6 text-muted-foreground'>贯穿案例：{chapter.caseStudy}。本文不会先抛定义，而是按原视频顺序让代码经历需求、失败与重构。</p>
    <ol class='mt-5 grid gap-2 sm:grid-cols-2'>
      {sessions.map((session, step) => (
        <li class='rounded-xl border border-border bg-card/80 p-3'>
          <div class='flex items-center justify-between gap-3 text-xs'><strong class='text-foreground'>第 {step + 1} 步 · P{session.page}</strong><span class='text-muted-foreground'>{getProgrammingThoughtsDuration(session)}</span></div>
          <p class='mt-1 text-xs leading-5 text-muted-foreground'>{session.title}</p>
          <a href={getProgrammingThoughtsVideoUrl(session)} target='_blank' rel='noopener noreferrer' class='mt-2 inline-block text-xs text-primary hover:underline'>打开这一分 P ↗</a>
        </li>
      ))}
    </ol>
  </div>
  <details class='overflow-hidden rounded-2xl border border-border bg-card'>
    <summary class='cursor-pointer px-5 py-4 text-sm font-medium text-foreground'>在页面内观看第一段视频</summary>
    <div class='aspect-video bg-black'><iframe src={getProgrammingThoughtsEmbedUrl(sessions[0])} title={`${chapter.title} P${chapter.startPage}`} class='size-full' loading='lazy' allowfullscreen sandbox='allow-top-navigation allow-same-origin allow-forms allow-scripts'></iframe></div>
  </details>
  <nav class='grid gap-3 sm:grid-cols-2' aria-label='编程思想课程前后章节'>
    {previous ? <a href={`/notes/programming-thoughts/course/${previous.slug}`} class='rounded-xl border border-border bg-card p-4 transition-colors hover:bg-muted/60'><span class='text-xs text-muted-foreground'>← 上一章 · P{previous.startPage}–P{previous.endPage}</span><strong class='mt-1 block text-sm text-foreground'>{previous.shortTitle}</strong></a> : <a href='/notes/programming-thoughts/course' class='rounded-xl border border-border bg-card p-4'><span class='text-xs text-muted-foreground'>← 返回</span><strong class='mt-1 block text-sm text-foreground'>课程目录</strong></a>}
    {next ? <a href={`/notes/programming-thoughts/course/${next.slug}`} class='rounded-xl border border-border bg-card p-4 text-right transition-colors hover:bg-muted/60'><span class='text-xs text-muted-foreground'>下一章 · P{next.startPage}–P{next.endPage} →</span><strong class='mt-1 block text-sm text-foreground'>{next.shortTitle}</strong></a> : <a href='/notes/programming-thoughts/course' class='rounded-xl border border-border bg-card p-4 text-right'><span class='text-xs text-muted-foreground'>已完成 →</span><strong class='mt-1 block text-sm text-foreground'>回到目录复盘</strong></a>}
  </nav>
</section>
