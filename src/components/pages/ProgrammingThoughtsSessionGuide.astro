---
import {
  getProgrammingThoughtsChapterSessions,
  getProgrammingThoughtsDuration,
  getProgrammingThoughtsEmbedUrl,
  getProgrammingThoughtsVideoUrl,
  programmingThoughtsPhases
} from '@/utils/programming-thoughts-sessions'
import type { ProgrammingThoughtsChapter } from '@/utils/programming-thoughts-sessions'

interface Props {
  chapter: ProgrammingThoughtsChapter
}
const { chapter } = Astro.props
const sessions = getProgrammingThoughtsChapterSessions(chapter)
const phase = programmingThoughtsPhases.find((item) => item.id === chapter.phase)
const minutes = Math.round(sessions.reduce((sum, session) => sum + session.durationSeconds, 0) / 60)
---

<details
  class='reader-course-guide not-prose mb-8 overflow-hidden rounded-xl border border-border'
  data-programming-thoughts-chapter={chapter.slug}
>
  <summary class='cursor-pointer px-4 py-3 text-sm text-muted-foreground'>
    课程资料 · P{chapter.startPage}–P{chapter.endPage} · 约 {minutes} 分钟
  </summary>
  <div class='space-y-5 border-t border-border p-4 sm:p-5'>
    <div class='flex flex-wrap items-center gap-2 text-xs font-semibold tracking-wide text-primary'>
      <span>P{chapter.startPage}–P{chapter.endPage}</span><span>·</span><span>{phase?.label}</span
      ><span>·</span><span>约 {minutes} 分钟视频</span>
    </div>
    <h2 class='mt-3 text-lg font-semibold text-foreground'>{chapter.question}</h2>
    <p class='mt-2 text-sm leading-6 text-muted-foreground'>贯穿案例：{chapter.caseStudy}。</p>
    <ol class='mt-5 grid gap-2 sm:grid-cols-2'>
      {
        sessions.map((session, step) => (
          <li class='rounded-xl border border-border bg-card/80 p-3'>
            <div class='flex items-center justify-between gap-3 text-xs'>
              <>
                <strong class='text-foreground'>
                  第 {step + 1} 步 · P{session.page}
                </strong>
                <span class='text-muted-foreground'>{getProgrammingThoughtsDuration(session)}</span>
              </>
            </div>
            <p class='mt-1 text-xs leading-5 text-muted-foreground'>{session.title}</p>
            <a
              href={getProgrammingThoughtsVideoUrl(session)}
              target='_blank'
              rel='noopener noreferrer'
              class='mt-2 inline-block text-xs text-primary hover:underline'
            >
              打开这一分 P ↗
            </a>
          </li>
        ))
      }
    </ol>
    <details class='overflow-hidden rounded-2xl border border-border bg-card'>
      <summary class='cursor-pointer px-5 py-4 text-sm font-medium text-foreground'
        >在页面内观看第一段视频</summary
      >
      <div class='aspect-video bg-black'>
        <iframe
          src={getProgrammingThoughtsEmbedUrl(sessions[0])}
          title={`${chapter.title} P${chapter.startPage}`}
          class='size-full'
          loading='lazy'
          allowfullscreen
          sandbox='allow-top-navigation allow-same-origin allow-forms allow-scripts'></iframe>
      </div>
    </details>
  </div>
</details>
