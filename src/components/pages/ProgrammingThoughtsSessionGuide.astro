---
import {
  getProgrammingThoughtsDuration,
  getProgrammingThoughtsEmbedUrl,
  getProgrammingThoughtsVideoUrl,
  programmingThoughtsPhases,
  programmingThoughtsSessions
} from '@/utils/programming-thoughts-sessions'
import type { ProgrammingThoughtsSession } from '@/utils/programming-thoughts-sessions'

interface Props {
  session: ProgrammingThoughtsSession
}

const { session } = Astro.props
const index = programmingThoughtsSessions.findIndex((item) => item.page === session.page)
const previous = programmingThoughtsSessions[index - 1]
const next = programmingThoughtsSessions[index + 1]
const phase = programmingThoughtsPhases.find((item) => item.id === session.phase)
---

<section class='not-prose mb-8 space-y-5' data-programming-thoughts-session={session.page}>
  <div class='overflow-hidden rounded-2xl border border-border bg-card'>
    <div class='aspect-video bg-black'>
      <iframe
        src={getProgrammingThoughtsEmbedUrl(session)}
        title={`编程思想 P${session.page}：${session.title}`}
        class='size-full'
        loading='lazy'
        allowfullscreen
        sandbox='allow-top-navigation allow-same-origin allow-forms allow-scripts'></iframe>
    </div>

    <div class='grid gap-4 p-5 sm:grid-cols-[1fr_auto] sm:items-start'>
      <div>
        <div class='flex flex-wrap items-center gap-2 text-xs font-semibold tracking-wide text-primary'>
          <span>B 站 P{session.page}</span>
          <span aria-hidden='true'>·</span>
          <span>{phase?.label}</span>
          <span aria-hidden='true'>·</span>
          <span>{getProgrammingThoughtsDuration(session)}</span>
        </div>
        <p class='mt-2 text-sm text-muted-foreground'>原视频：{session.sourceTitle}</p>
      </div>
      <a
        href={getProgrammingThoughtsVideoUrl(session)}
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex rounded-lg border border-border px-3 py-2 text-sm transition-colors hover:bg-muted'
      >
        在 B 站打开 P{session.page} ↗
      </a>
    </div>
  </div>

  <div class='grid gap-4 lg:grid-cols-[1.25fr_0.75fr]'>
    <section class='rounded-2xl border border-primary/20 bg-primary/[0.04] p-5'>
      <p class='text-xs font-semibold uppercase tracking-[0.18em] text-primary'>本节先回答</p>
      <h2 class='mt-2 text-base font-semibold leading-7 text-foreground'>{session.question}</h2>
      <div class='mt-4 grid grid-cols-[repeat(5,minmax(0,1fr))] items-center gap-1 text-center text-[10px] text-muted-foreground sm:text-xs'>
        {['坏味道', '变化轴', '边界', '协作方式', '代价'].map((step, stepIndex) => (
          <>
            <span class='rounded-lg border border-border bg-card px-1 py-2'>{step}</span>
            {stepIndex < 4 && <span class='hidden' aria-hidden='true'>→</span>}
          </>
        ))}
      </div>
    </section>

    <section class='rounded-2xl border border-border bg-card/70 p-5'>
      <h2 class='text-sm font-semibold text-foreground'>知识点与贯穿案例</h2>
      <ul class='mt-3 flex flex-wrap gap-2'>
        {session.topics.map((topic) => (
          <li class='rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground'>{topic}</li>
        ))}
      </ul>
      <p class='mt-4 text-sm text-muted-foreground'>案例：<strong class='text-foreground'>{session.example}</strong></p>
    </section>
  </div>

  <nav class='grid gap-3 sm:grid-cols-2' aria-label='编程思想课程前后章节'>
    {previous ? (
      <a
        href={`/notes/programming-thoughts/course/${previous.slug}`}
        class='rounded-xl border border-border bg-card p-4 transition-colors hover:bg-muted/60'
      >
        <span class='text-xs text-muted-foreground'>← 上一讲 · P{previous.page}</span>
        <strong class='mt-1 block text-sm text-foreground'>{previous.title}</strong>
      </a>
    ) : (
      <a
        href='/notes/programming-thoughts/course'
        class='rounded-xl border border-border bg-card p-4 transition-colors hover:bg-muted/60'
      >
        <span class='text-xs text-muted-foreground'>← 返回</span>
        <strong class='mt-1 block text-sm text-foreground'>46 讲课程目录</strong>
      </a>
    )}
    {next ? (
      <a
        href={`/notes/programming-thoughts/course/${next.slug}`}
        class='rounded-xl border border-border bg-card p-4 text-right transition-colors hover:bg-muted/60'
      >
        <span class='text-xs text-muted-foreground'>下一讲 · P{next.page} →</span>
        <strong class='mt-1 block text-sm text-foreground'>{next.title}</strong>
      </a>
    ) : (
      <a
        href='/notes/programming-thoughts/course'
        class='rounded-xl border border-border bg-card p-4 text-right transition-colors hover:bg-muted/60'
      >
        <span class='text-xs text-muted-foreground'>已完成 46 讲 →</span>
        <strong class='mt-1 block text-sm text-foreground'>回到课程目录复盘</strong>
      </a>
    )}
  </nav>
</section>
