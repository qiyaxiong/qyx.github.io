---
import type { NoteTreeNode } from '@/utils/server'
import ProgrammingThoughtsSidebarTree from './ProgrammingThoughtsSidebarTree.astro'

interface Props {
  nodes: NoteTreeNode[]
  basePath: string
  currentPath: string
  level?: number
  directoryLabel: string
  homeLabel: string
}

const {
  nodes,
  basePath,
  currentPath,
  level = 0,
  directoryLabel,
  homeLabel
} = Astro.props

function getNodeHref(path: string) {
  return path ? `${basePath}/${path}` : basePath
}

function isCurrentBranch(path: string) {
  return currentPath === path || currentPath.startsWith(`${path}/`)
}
---

<ul class:list={['flex flex-col gap-1', level > 0 && 'mt-1 border-s border-border/60 ps-2']}>
  {
    nodes.map((node) => {
      const title = node.page?.title || node.title
      const isActive = node.path === currentPath
      const isBranch = isCurrentBranch(node.path)
      const isProgrammingThoughtsCourse = node.path === 'programming-thoughts/course'

      return (
        <li>
          {isProgrammingThoughtsCourse ? (
            <section data-knowledge-topic data-current-topic={isBranch ? 'true' : undefined}>
              <h3 class='m-0 px-3 py-2 text-sm font-medium text-foreground'>{title}</h3>
              <ProgrammingThoughtsSidebarTree {currentPath} {basePath} />
            </section>
          ) : node.children.length > 0 ? (
            <details
              open={isBranch}
              data-knowledge-topic
              data-current-topic={isBranch ? 'true' : undefined}
              class='group/topic'
            >
              <summary
                class:list={[
                  'flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-2 text-sm transition-colors marker:content-none [&::-webkit-details-marker]:hidden',
                  isBranch
                    ? 'text-foreground'
                    : 'text-muted-foreground hover:bg-muted/70 hover:text-foreground'
                ]}
              >
                <svg
                  aria-hidden='true'
                  class='size-3.5 shrink-0 -rotate-90 transition-transform duration-200 group-open/topic:rotate-0'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                >
                  <path d='m6 9 6 6 6-6' stroke-linecap='round' stroke-linejoin='round' />
                </svg>
                <span class='min-w-0 flex-1 truncate font-medium'>{title}</span>
                <span class='shrink-0 text-[10px] uppercase tracking-[0.14em] text-muted-foreground'>
                  {directoryLabel}
                </span>
              </summary>

              <div class='mt-1 border-s border-border/60 ps-2'>
                {node.page && (
                  <a
                    href={getNodeHref(node.path)}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition-colors',
                      isActive
                        ? 'bg-muted text-foreground'
                        : 'text-muted-foreground hover:bg-muted/70 hover:text-foreground'
                    ]}
                  >
                    <span class:list={['inline-block size-1.5 rounded-full', isActive ? 'bg-primary' : 'bg-border']} />
                    <span class='min-w-0 truncate'>{homeLabel}</span>
                  </a>
                )}
                <Astro.self
                  nodes={node.children}
                  {basePath}
                  {currentPath}
                  level={level + 1}
                  {directoryLabel}
                  {homeLabel}
                />
              </div>
            </details>
          ) : (
            <a
              href={getNodeHref(node.path)}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition-colors',
                isActive
                  ? 'bg-muted text-foreground'
                  : 'text-muted-foreground hover:bg-muted/70 hover:text-foreground'
              ]}
            >
              <span class:list={['inline-block size-1.5 rounded-full', isActive ? 'bg-primary' : 'bg-border']} />
              <span class='min-w-0 truncate'>{title}</span>
            </a>
          )}
        </li>
      )
    })
  }
</ul>
