---
import type { Cs229ReaderConfig } from '@/utils/cs229-reader'

interface Props {
  config: Cs229ReaderConfig
  html: string
}

const { config, html } = Astro.props
const initialPdfUrl = `${config.pdfUrl}#page=${config.pageStart}&view=FitH`
---

<section
  class='cs229-reader'
  data-cs229-reader
  data-mode='compare'
  data-mobile-pane='zh'
  data-storage-key={config.storageKey}
  data-page-start={config.pageStart}
>
  <div class='reader-toolbar not-prose' aria-label='阅读模式'>
    <div class='reader-mode-tabs' role='tablist' aria-label='中文、英文与对照模式'>
      <button type='button' role='tab' data-reader-mode='zh' aria-selected='false'>
        中文讲解
      </button>
      <button type='button' role='tab' data-reader-mode='source' aria-selected='false'>
        英文原版
      </button>
      <button type='button' role='tab' data-reader-mode='compare' aria-selected='true'>
        中英对照
      </button>
    </div>

    <a href={config.sourceDocumentUrl} target='_blank' rel='noopener noreferrer'> 原讲义 PDF ↗ </a>
  </div>

  <div class='reader-source-note not-prose'>
    <div>
      <span class='reader-eyebrow'>SOURCE-AWARE READING</span>
      <p>
        中文部分是本站重新组织的完整讲解；英文模式使用 PDF.js 直接读取原仓库文件，不在本站复制原文。
      </p>
    </div>
    <div class='reader-page-range'>
      <strong>PDF {config.pageStart}–{config.pageEnd}</strong>
      <span>{config.sourceTitle}</span>
    </div>
  </div>

  <nav class='reader-section-map not-prose' aria-label='中英文小节与原讲义页码'>
    {
      config.sections.map((section) => (
        <button
          type='button'
          data-reader-section
          data-section-id={section.id}
          data-source-page={section.page}
        >
          <span>
            <strong>{section.zh}</strong>
            <small>{section.en}</small>
          </span>
          <em>P.{section.page}</em>
        </button>
      ))
    }
  </nav>

  <div class='reader-mobile-pane not-prose' role='tablist' aria-label='移动端对照面板'>
    <button type='button' role='tab' data-mobile-pane='zh' aria-selected='true'> 中文 </button>
    <button type='button' role='tab' data-mobile-pane='source' aria-selected='false'>
      原版 PDF
    </button>
  </div>

  <div class='reader-layout'>
    <article class='reader-zh-panel' data-reader-panel='zh'>
      <div class='reader-panel-label not-prose'>
        <span>中文重构讲义</span>
        <span>按知识依赖重排，不是逐句翻译</span>
      </div>
      <Fragment set:html={html} />
    </article>

    <aside class='reader-source-panel not-prose' data-reader-panel='source'>
      <div class='reader-pdf-header'>
        <div>
          <span>英文原版</span>
          <strong data-current-page>PDF 第 {config.pageStart} 页</strong>
        </div>
        <a data-open-current-page href={initialPdfUrl} target='_blank' rel='noopener noreferrer'>
          新窗口打开 ↗
        </a>
      </div>

      <div
        class='reader-pdf-viewport'
        role='img'
        aria-label={`${config.sourceTitle} 第 ${config.pageStart} 页`}
        data-pdf-base={config.pdfUrl}
      >
        <div class='reader-pdf-status' data-pdf-status>正在载入原版 PDF…</div>
        <canvas data-pdf-canvas></canvas>
      </div>

      <div class='reader-pdf-fallback'>
        <p>如果当前浏览器不能内嵌显示 PDF，请使用“新窗口打开”。</p>
        <a href={config.sourceRepositoryUrl} target='_blank' rel='noopener noreferrer'>
          查看来源仓库 ↗
        </a>
      </div>
    </aside>
  </div>
</section>

<script>
  import * as pdfjs from 'pdfjs-dist'
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url'

  pdfjs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl

  type ReaderMode = 'zh' | 'source' | 'compare'
  type MobilePane = 'zh' | 'source'

  function initializeCs229Reader(reader: HTMLElement) {
    if (reader.dataset.initialized === 'true') return
    reader.dataset.initialized = 'true'

    const storageKey = reader.dataset.storageKey || 'cs229-reader'
    const modeButtons = Array.from(reader.querySelectorAll<HTMLButtonElement>('[data-reader-mode]'))
    const paneButtons = Array.from(reader.querySelectorAll<HTMLButtonElement>('[data-mobile-pane]'))
    const sectionButtons = Array.from(
      reader.querySelectorAll<HTMLButtonElement>('[data-reader-section]')
    )
    const pdfViewport = reader.querySelector<HTMLElement>('[data-pdf-base]')
    const pdfCanvas = reader.querySelector<HTMLCanvasElement>('[data-pdf-canvas]')
    const pdfStatus = reader.querySelector<HTMLElement>('[data-pdf-status]')
    const currentPage = reader.querySelector<HTMLElement>('[data-current-page]')
    const openCurrentPage = reader.querySelector<HTMLAnchorElement>('[data-open-current-page]')
    const pdfBase = pdfViewport?.dataset.pdfBase
    const pdfDocument = pdfBase ? pdfjs.getDocument({ url: pdfBase }).promise : undefined
    let activePage = Number(reader.dataset.pageStart || 1)
    let renderVersion = 0
    let resizeTimer: number | undefined

    const setMode = (mode: ReaderMode) => {
      reader.dataset.mode = mode
      modeButtons.forEach((button) => {
        button.setAttribute('aria-selected', String(button.dataset.readerMode === mode))
      })

      try {
        localStorage.setItem(`${storageKey}:mode`, mode)
      } catch {
        // Reading mode persistence is optional.
      }
    }

    const setMobilePane = (pane: MobilePane) => {
      reader.dataset.mobilePane = pane
      paneButtons.forEach((button) => {
        button.setAttribute('aria-selected', String(button.dataset.mobilePane === pane))
      })
    }

    const renderPdfPage = async (pageNumber: number) => {
      if (!pdfDocument || !pdfCanvas || !pdfViewport) return

      const version = ++renderVersion
      if (pdfStatus) {
        pdfStatus.hidden = false
        pdfStatus.textContent = `正在载入第 ${pageNumber} 页…`
      }

      try {
        const document = await pdfDocument
        const page = await document.getPage(pageNumber)
        if (version !== renderVersion) return

        const baseViewport = page.getViewport({ scale: 1 })
        const availableWidth = Math.max(pdfViewport.clientWidth - 24, 280)
        const cssScale = availableWidth / baseViewport.width
        const viewport = page.getViewport({ scale: cssScale })
        const outputScale = Math.min(window.devicePixelRatio || 1, 2)
        const context = pdfCanvas.getContext('2d')
        if (!context) throw new Error('Canvas 2D context is unavailable')

        pdfCanvas.width = Math.floor(viewport.width * outputScale)
        pdfCanvas.height = Math.floor(viewport.height * outputScale)
        pdfCanvas.style.width = `${Math.floor(viewport.width)}px`
        pdfCanvas.style.height = `${Math.floor(viewport.height)}px`

        await page.render({
          canvas: pdfCanvas,
          canvasContext: context,
          viewport,
          transform: outputScale === 1 ? undefined : [outputScale, 0, 0, outputScale, 0, 0]
        }).promise

        if (version !== renderVersion) return
        pdfViewport.setAttribute('aria-label', `英文原版 PDF 第 ${pageNumber} 页`)
        if (pdfStatus) pdfStatus.hidden = true
      } catch {
        if (version !== renderVersion || !pdfStatus) return
        pdfStatus.hidden = false
        pdfStatus.textContent = '当前网络无法载入 PDF，请使用“新窗口打开”。'
      }
    }

    const setPdfPage = (page: string) => {
      if (!pdfBase) return

      activePage = Number(page)
      const pageUrl = `${pdfBase}#page=${page}&view=FitH`
      if (currentPage) currentPage.textContent = `PDF 第 ${page} 页`
      if (openCurrentPage) openCurrentPage.href = pageUrl
      void renderPdfPage(activePage)
    }

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => setMode(button.dataset.readerMode as ReaderMode))
    })

    paneButtons.forEach((button) => {
      button.addEventListener('click', () => setMobilePane(button.dataset.mobilePane as MobilePane))
    })

    sectionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const page = button.dataset.sourcePage
        const sectionId = button.dataset.sectionId
        if (page) setPdfPage(page)

        if (reader.dataset.mode !== 'source' && sectionId) {
          document.getElementById(sectionId)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
        }
      })
    })

    let savedMode: ReaderMode = 'compare'
    try {
      const candidate = localStorage.getItem(`${storageKey}:mode`)
      if (candidate === 'zh' || candidate === 'source' || candidate === 'compare') {
        savedMode = candidate
      }
    } catch {
      // Use the default compare mode when storage is unavailable.
    }

    setMode(savedMode)
    setMobilePane('zh')
    void renderPdfPage(activePage)

    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(() => void renderPdfPage(activePage), 180)
    })
  }

  document.querySelectorAll<HTMLElement>('[data-cs229-reader]').forEach(initializeCs229Reader)
</script>

<style>
  .cs229-reader {
    --reader-accent: 14 116 144;
  }

  .reader-toolbar {
    position: sticky;
    top: 4.75rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.65rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    background: hsl(var(--background) / 0.9);
    box-shadow: 0 8px 30px hsl(var(--foreground) / 0.06);
    backdrop-filter: blur(16px);
  }

  .reader-toolbar > a,
  .reader-pdf-header a,
  .reader-pdf-fallback a {
    color: hsl(var(--foreground));
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
  }

  .reader-mode-tabs {
    display: flex;
    min-width: 0;
    gap: 0.25rem;
  }

  .reader-mode-tabs button,
  .reader-mobile-pane button {
    min-height: 2.5rem;
    padding: 0.5rem 0.8rem;
    border: 0;
    border-radius: 0.65rem;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .reader-mode-tabs button[aria-selected='true'],
  .reader-mobile-pane button[aria-selected='true'] {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  .reader-source-note {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 1rem;
    border: 1px solid rgb(var(--reader-accent) / 0.25);
    border-radius: 1rem;
    background: rgb(var(--reader-accent) / 0.06);
  }

  .reader-eyebrow {
    color: rgb(var(--reader-accent));
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .reader-source-note p {
    margin: 0.35rem 0 0;
    color: hsl(var(--foreground));
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .reader-page-range {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
  }

  .reader-page-range strong {
    color: hsl(var(--foreground));
    font-size: 1rem;
  }

  .reader-section-map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .reader-section-map button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    gap: 0.75rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    text-align: left;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .reader-section-map button:hover {
    border-color: rgb(var(--reader-accent) / 0.5);
    background: rgb(var(--reader-accent) / 0.05);
  }

  .reader-section-map button span {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .reader-section-map strong {
    overflow: hidden;
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader-section-map small {
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader-section-map em {
    color: rgb(var(--reader-accent));
    font-size: 0.7rem;
    font-style: normal;
    font-weight: 700;
  }

  .reader-mobile-pane {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    margin-bottom: 1rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
    background: hsl(var(--muted));
  }

  .reader-layout {
    min-width: 0;
  }

  .reader-panel-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }

  .reader-panel-label span:first-child {
    color: rgb(var(--reader-accent));
    font-weight: 700;
  }

  .reader-source-panel {
    display: none;
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    background: hsl(var(--card));
  }

  .reader-pdf-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .reader-pdf-header div {
    display: flex;
    flex-direction: column;
  }

  .reader-pdf-header span {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }

  .reader-pdf-header strong {
    font-size: 0.82rem;
  }

  .reader-pdf-viewport {
    position: relative;
    display: flex;
    width: 100%;
    min-height: min(70vh, 48rem);
    align-items: flex-start;
    justify-content: center;
    overflow: auto;
    padding: 0.75rem;
    background: #e5e7eb;
  }

  .reader-pdf-viewport canvas {
    display: block;
    max-width: none;
    border-radius: 0.2rem;
    background: white;
    box-shadow: 0 12px 32px rgb(15 23 42 / 0.18);
  }

  .reader-pdf-status {
    position: absolute;
    top: 1.5rem;
    left: 50%;
    z-index: 2;
    max-width: calc(100% - 2rem);
    transform: translateX(-50%);
    padding: 0.55rem 0.75rem;
    border-radius: 0.6rem;
    background: rgb(15 23 42 / 0.84);
    color: white;
    font-size: 0.72rem;
    text-align: center;
    backdrop-filter: blur(8px);
  }

  .reader-pdf-fallback {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border-top: 1px solid hsl(var(--border));
  }

  .reader-pdf-fallback p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
  }

  .cs229-reader[data-mode='source'] .reader-zh-panel {
    display: none;
  }

  .cs229-reader[data-mode='source'] .reader-source-panel {
    display: block;
  }

  .cs229-reader[data-mode='compare'] .reader-mobile-pane {
    display: grid;
  }

  .cs229-reader[data-mode='compare'][data-mobile-pane='source'] .reader-zh-panel {
    display: none;
  }

  .cs229-reader[data-mode='compare'][data-mobile-pane='source'] .reader-source-panel {
    display: block;
  }

  @media (min-width: 640px) {
    .reader-source-note {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .reader-section-map {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .reader-toolbar {
      top: 5.25rem;
    }

    .cs229-reader[data-mode='compare'] .reader-mobile-pane {
      display: none;
    }

    .cs229-reader[data-mode='compare'] .reader-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(24rem, 0.95fr);
      align-items: start;
      gap: 1.25rem;
    }

    .cs229-reader[data-mode='compare'] .reader-zh-panel,
    .cs229-reader[data-mode='compare'] .reader-source-panel {
      display: block;
    }

    .cs229-reader[data-mode='compare'] .reader-source-panel {
      position: sticky;
      top: 9.4rem;
    }
  }

  @media (max-width: 639px) {
    .reader-toolbar {
      align-items: stretch;
      flex-direction: column;
    }

    .reader-toolbar > a {
      padding: 0 0.4rem 0.2rem;
    }

    .reader-mode-tabs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .reader-mode-tabs button {
      padding-inline: 0.35rem;
    }

    .reader-panel-label {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
