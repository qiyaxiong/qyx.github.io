---
import type { MarkdownHeading } from 'astro'

import ContentLayout from '@/layouts/ContentLayout.astro'
import { TOC } from '@/components/pages'
import Cs229BilingualReader from '@/components/pages/Cs229BilingualReader.astro'
import Cs229CourseOverview from '@/components/pages/Cs229CourseOverview.astro'
import Cs229SessionGuide from '@/components/pages/Cs229SessionGuide.astro'
import ProgrammingThoughtsCourseOverview from '@/components/pages/ProgrammingThoughtsCourseOverview.astro'
import ProgrammingThoughtsSessionGuide from '@/components/pages/ProgrammingThoughtsSessionGuide.astro'
import NotesTree from '@/components/pages/NotesTree.astro'
import { Icon } from '@/components/user'
import { getCs229ReaderConfig } from '@/utils/cs229-reader'
import { getCs229Session } from '@/utils/cs229-sessions'
import { getProgrammingThoughtsSession } from '@/utils/programming-thoughts-sessions'
import type { NoteTreeNode } from '@/utils/server'

interface BreadcrumbItem {
  title: string
  href: string
}

interface Props {
  title: string
  description: string
  language?: 'zh' | 'en'
  basePath: string
  currentPath: string
  rootTitle: string
  treeNodes: NoteTreeNode[]
  breadcrumbs: BreadcrumbItem[]
  childNodes: NoteTreeNode[]
  headings?: MarkdownHeading[]
  html?: string
}

const {
  title,
  description,
  language = 'zh',
  basePath,
  currentPath,
  rootTitle,
  treeNodes,
  breadcrumbs,
  childNodes,
  headings = [],
  html
} = Astro.props
const cs229ReaderConfig = getCs229ReaderConfig(currentPath)
const cs229Session = getCs229Session(currentPath)
const isCs229CourseIndex = currentPath === 'cs229/course'
const programmingThoughtsSession = getProgrammingThoughtsSession(currentPath)
const isProgrammingThoughtsCourseIndex = currentPath === 'programming-thoughts/course'

const copy =
  language === 'zh'
    ? {
        empty: '还没有笔记。',
        directoryHint: '这是一个专题目录。可以先阅读下面的导读，再选择子笔记继续。',
        subnotes: '专题与笔记',
        items: '项内容',
        directory: '专题',
        nestedNotes: (count: number) => `包含 ${count} 篇下级笔记`,
        readNote: '阅读笔记',
        directSubnotes: (count: number) => `${count} 篇子笔记`,
        topicHome: '专题首页'
      }
    : {
        empty: 'No notes yet.',
        directoryHint: 'This is a note directory. Pick a subnote below to continue reading.',
        subnotes: 'Subnotes',
        items: 'items',
        directory: 'Dir',
        nestedNotes: (count: number) => `${count} nested notes`,
        readNote: 'Read note',
        directSubnotes: (count: number) => `${count} direct subnotes`,
        topicHome: 'Topic home'
      }

function getNodeHref(path: string) {
  return path ? `${basePath}/${path}` : basePath
}

function countDescendants(node: NoteTreeNode): number {
  return node.children.reduce((count, child) => count + 1 + countDescendants(child), 0)
}
---

<ContentLayout meta={{ title, description }} back={basePath}>
  <Fragment slot='sidebar'>
    <div class='space-y-8'>
      <section>
        <h2 class='text-xs font-semibold tracking-[0.22em] text-muted-foreground'>{rootTitle}</h2>
        {
          treeNodes.length > 0 ? (
            <div class='mt-4'>
              <NotesTree
                nodes={treeNodes}
                {basePath}
                {currentPath}
                directoryLabel={copy.directory}
                homeLabel={copy.topicHome}
              />
            </div>
          ) : (
            <p class='mt-4 text-sm text-muted-foreground'>{copy.empty}</p>
          )
        }
      </section>

      {!!headings.length && <TOC {headings} />}
    </div>
  </Fragment>

  <Fragment slot='header'>
    <div class='flex flex-wrap items-center gap-2 text-sm text-muted-foreground'>
      {
        breadcrumbs.map((item, index) => (
          <>
            {index > 0 && <Icon name='chevron-down' class='size-4 -rotate-90' />}
            {index === breadcrumbs.length - 1 ? (
              <span>{item.title}</span>
            ) : (
              <a href={item.href} class='transition-colors hover:text-foreground'>
                {item.title}
              </a>
            )}
          </>
        ))
      }
    </div>
    <h1 class='mt-4 text-2xl font-medium sm:text-3xl'>{title}</h1>
    <p class='mt-3 text-sm text-muted-foreground sm:text-base'>{description}</p>
  </Fragment>

  {
    !html && (
      <div class='not-prose rounded-2xl border border-dashed border-border bg-card/70 px-5 py-6 text-sm text-muted-foreground'>
        {copy.directoryHint}
      </div>
    )
  }

  {cs229Session && <Cs229SessionGuide session={cs229Session} />}

  {
    programmingThoughtsSession && (
      <ProgrammingThoughtsSessionGuide session={programmingThoughtsSession} />
    )
  }

  {
    html &&
      (cs229ReaderConfig ? (
        <Cs229BilingualReader config={cs229ReaderConfig} {html} />
      ) : (
        <Fragment set:html={html} />
      ))
  }

  {isCs229CourseIndex && <Cs229CourseOverview />}

  {isProgrammingThoughtsCourseIndex && <ProgrammingThoughtsCourseOverview />}

  {
    !!childNodes.length && !isCs229CourseIndex && !isProgrammingThoughtsCourseIndex && (
      <section class='not-prose mt-10'>
        <div class='mb-4 flex items-center justify-between gap-3'>
          <h2 class='text-lg font-semibold text-foreground'>{copy.subnotes}</h2>
          <span class='text-sm text-muted-foreground'>
            {childNodes.length} {copy.items}
          </span>
        </div>

        <div class='grid gap-3 sm:grid-cols-2'>
          {childNodes.map((node) => {
            const descendants = countDescendants(node)
            const subtitle =
              node.page?.description ||
              (node.page
                ? descendants > 0
                  ? copy.nestedNotes(descendants)
                  : copy.readNote
                : copy.directSubnotes(node.children.length))

            return (
              <a
                href={getNodeHref(node.path)}
                class='group rounded-xl border border-border bg-card p-4 transition-all hover:border-primary/40 hover:bg-muted/50 hover:shadow-sm'
              >
                <div class='flex items-start justify-between gap-4'>
                  <div class='min-w-0'>
                    <h3 class='line-clamp-2 text-base font-semibold text-foreground transition-colors group-hover:text-primary'>
                      {node.page?.title || node.title}
                    </h3>
                    <p class='mt-1 text-sm text-muted-foreground'>{subtitle}</p>
                  </div>
                  <Icon
                    name='chevron-down'
                    class='mt-0.5 size-4 shrink-0 -rotate-90 text-muted-foreground transition-colors group-hover:text-primary'
                  />
                </div>
              </a>
            )
          })}
        </div>
      </section>
    )
  }
</ContentLayout>
