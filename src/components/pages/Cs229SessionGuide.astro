---
import { getCs229EmbedUrl, getCs229MaterialUrl, getCs229VideoUrl } from '@/utils/cs229-sessions'
import type { Cs229Session } from '@/utils/cs229-sessions'

interface Props {
  session: Cs229Session
}

const { session } = Astro.props
---

<section class='not-prose mb-8 space-y-5' data-cs229-session={session.videoPage}>
  <div class='overflow-hidden rounded-2xl border border-border bg-card'>
    <div class='aspect-video bg-black'>
      <iframe
        src={getCs229EmbedUrl(session)}
        title={`CS229 ${session.label}：${session.titleZh}`}
        class='size-full'
        loading='lazy'
        allowfullscreen
        sandbox='allow-top-navigation allow-same-origin allow-forms allow-scripts'></iframe>
    </div>

    <div class='grid gap-4 p-5 sm:grid-cols-[1fr_auto] sm:items-start'>
      <div>
        <div
          class='flex flex-wrap items-center gap-2 text-xs font-semibold tracking-wide text-primary'
        >
          <span>B 站 P{session.videoPage}</span>
          <span aria-hidden='true'>·</span>
          <span>{session.label}</span>
          {
            session.date && (
              <>
                <span aria-hidden='true'>·</span>
                <span>{session.date}</span>
              </>
            )
          }
          <span aria-hidden='true'>·</span>
          <span>{session.duration}</span>
        </div>
        <h2 class='mt-2 text-lg font-semibold text-foreground'>{session.titleZh}</h2>
        <p class='mt-1 text-sm text-muted-foreground'>{session.titleEn}</p>
      </div>
      <a
        href={getCs229VideoUrl(session)}
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex rounded-lg border border-border px-3 py-2 text-sm transition-colors hover:bg-muted'
      >
        在 B 站打开 P{session.videoPage} ↗
      </a>
    </div>
  </div>

  <div class='grid gap-4 lg:grid-cols-2'>
    <section class='rounded-2xl border border-border bg-card/70 p-5'>
      <h2 class='text-sm font-semibold text-foreground'>本节知识点</h2>
      <ul class='mt-3 flex flex-wrap gap-2'>
        {
          session.topics.map((topic) => (
            <li class='rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground'>{topic}</li>
          ))
        }
      </ul>
    </section>

    <section class='rounded-2xl border border-border bg-card/70 p-5'>
      <h2 class='text-sm font-semibold text-foreground'>课堂讲义与作业</h2>
      {
        session.materials.length || session.assignment ? (
          <ul class='mt-3 space-y-3 text-sm'>
            {session.materials.map((item) => (
              <li>
                <a
                  href={getCs229MaterialUrl(item)}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='font-medium text-foreground underline decoration-border underline-offset-4'
                >
                  {item.label} ↗
                </a>
                {item.detail && <p class='mt-1 text-xs text-muted-foreground'>{item.detail}</p>}
              </li>
            ))}
            {session.assignment && (
              <li>
                <a
                  href={getCs229MaterialUrl(session.assignment)}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='font-medium text-foreground underline decoration-border underline-offset-4'
                >
                  {session.assignment.label} ↗
                </a>
                {session.assignment.detail && (
                  <p class='mt-1 text-xs text-muted-foreground'>{session.assignment.detail}</p>
                )}
              </li>
            )}
          </ul>
        ) : (
          <p class='mt-3 text-sm text-muted-foreground'>
            这是一节课程导论；官方课表未为本节单列课堂讲义。
          </p>
        )
      }
    </section>
  </div>
</section>
