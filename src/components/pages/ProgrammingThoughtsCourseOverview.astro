---
import {
  getProgrammingThoughtsDuration,
  getProgrammingThoughtsVideoUrl,
  programmingThoughtsPhases,
  programmingThoughtsSessions
} from '@/utils/programming-thoughts-sessions'

const totalDuration = programmingThoughtsSessions.reduce(
  (total, session) => total + session.durationSeconds,
  0
)
const hours = Math.floor(totalDuration / 3600)
const minutes = Math.floor((totalDuration % 3600) / 60)
---

<div class='not-prose mt-10 space-y-10' data-programming-thoughts-course-overview>
  <section class='grid gap-3 sm:grid-cols-4'>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>46</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>分 P / 独立精讲</span>
    </div>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>{hours}h {minutes}m</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>原课程总时长</span>
    </div>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>7 + 11</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>设计原则 + 模式族</span>
    </div>
    <div class='rounded-2xl border border-border bg-card p-4'>
      <strong class='block text-2xl text-foreground'>46</strong>
      <span class='mt-1 block text-xs text-muted-foreground'>独立案例与练习</span>
    </div>
  </section>

  {programmingThoughtsPhases.map((phase) => {
    const sessions = programmingThoughtsSessions.filter((session) => session.phase === phase.id)

    return (
      <section id={phase.id} class='scroll-mt-24'>
        <div class='mb-4 sm:flex sm:items-end sm:justify-between sm:gap-6'>
          <div>
            <p class='text-xs font-semibold uppercase tracking-[0.18em] text-primary'>
              {phase.label} · {phase.range}
            </p>
            <h2 class='mt-1 text-lg font-semibold text-foreground'>{phase.title}</h2>
            <p class='mt-1 max-w-3xl text-sm leading-6 text-muted-foreground'>{phase.description}</p>
          </div>
          <span class='mt-2 inline-block text-xs text-muted-foreground sm:mt-0'>{sessions.length} 讲</span>
        </div>

        <ol class='grid gap-3 lg:grid-cols-2'>
          {sessions.map((session) => (
            <li class='rounded-2xl border border-border bg-card/70 p-4'>
              <div class='flex items-start gap-4'>
                <span class='flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-sm font-semibold text-primary'>
                  P{session.page}
                </span>
                <div class='min-w-0 flex-1'>
                  <div class='flex flex-wrap items-center gap-2 text-[11px] text-muted-foreground'>
                    <span>{getProgrammingThoughtsDuration(session)}</span>
                    <span aria-hidden='true'>·</span>
                    <span>{session.example}</span>
                  </div>
                  <a
                    href={`/notes/programming-thoughts/course/${session.slug}`}
                    class='mt-1 block font-medium leading-6 text-foreground transition-colors hover:text-primary'
                  >
                    {session.title}
                  </a>
                  <p class='mt-2 line-clamp-2 text-xs leading-5 text-muted-foreground'>{session.question}</p>
                  <div class='mt-3 flex items-center gap-2 text-xs'>
                    <span class='rounded-full bg-muted px-2.5 py-1 text-muted-foreground'>
                      {session.topics[0]}
                    </span>
                    <a
                      href={getProgrammingThoughtsVideoUrl(session)}
                      target='_blank'
                      rel='noopener noreferrer'
                      class='ms-auto text-primary hover:underline'
                    >
                      B 站 ↗
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  })}

  <section class='rounded-2xl border border-dashed border-border bg-card/40 p-5'>
    <h2 class='text-sm font-semibold text-foreground'>编号说明</h2>
    <p class='mt-2 text-sm leading-6 text-muted-foreground'>
      原合集在“迪米特原则”之后出现重复课号，最后一节标题写作第 45 讲，但 B 站实际共有 46 个分 P。本站始终以
      P1–P46 作为唯一映射；“原视频标题”会在每页顶部保留，站内标题只负责消除歧义。
    </p>
  </section>
</div>
