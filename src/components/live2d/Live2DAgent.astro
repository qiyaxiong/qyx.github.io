---
const enabled = import.meta.env.PUBLIC_LIVE2D_ENABLED !== 'false'
const apiBase = import.meta.env.PUBLIC_PI_AGENT_API_BASE || '/agent-api'
const provider = import.meta.env.PUBLIC_PI_AGENT_PROVIDER || 'dashscope'
const model = import.meta.env.PUBLIC_PI_AGENT_MODEL || 'qwen3-max'
const coreUrl = import.meta.env.PUBLIC_LIVE2D_CUBISM_CORE_URL || '/live2dcubismcore.min.js'
const coreFallbackUrl =
  import.meta.env.PUBLIC_LIVE2D_CUBISM_CORE_FALLBACK_URL ||
  'https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js'
const ttsEnabled = import.meta.env.PUBLIC_LIVE2D_TTS_ENABLED !== 'false'
---

{
  enabled && (
    <aside
      class='live2d-agent'
      data-live2d-agent
      data-api-base={apiBase}
      data-provider={provider}
      data-model={model}
      data-core-url={coreUrl}
      data-core-fallback-url={coreFallbackUrl}
      data-tts-enabled={String(ttsEnabled)}
      data-minimized='false'
      data-state='loading'
      data-audio-active='false'
      data-speech-visible='true'
      data-composer-open='false'
      aria-label='Live2D AI assistant'
    >
      <section class='live2d-panel' aria-label='Live2D assistant panel'>
        <header class='live2d-header'>
          <div class='live2d-status-wrap'>
            <span class='live2d-status-dot' aria-hidden='true' />
            <span class='live2d-status'>连接中</span>
          </div>
          <button class='live2d-minimize' type='button' aria-label='收起 Live2D 助手'>
            <svg viewBox='0 0 24 24' aria-hidden='true'>
              <path d='m7 7 10 10M17 7 7 17' />
            </svg>
          </button>
        </header>

        <div
          class='live2d-stage'
          role='button'
          tabindex='0'
          aria-label='和绘梦对话'
          aria-expanded='false'
        >
          <canvas class='live2d-canvas' aria-label='Live2D character' />
          <p class='live2d-speech' aria-live='polite'>
            正在唤醒绘梦…
          </p>
          <div class='live2d-action-card' data-live2d-action-card hidden aria-live='polite'>
            <p class='live2d-action-title' data-live2d-action-title />
            <p class='live2d-action-reason' data-live2d-action-reason />
            <div class='live2d-action-buttons'>
              <button class='live2d-action-confirm' data-live2d-action-confirm type='button'>
                打开
              </button>
              <button class='live2d-action-dismiss' data-live2d-action-dismiss type='button'>
                稍后
              </button>
            </div>
          </div>
        </div>

        <form class='live2d-form' aria-hidden='true'>
          <label class='sr-only' for='live2d-prompt'>
            给绘梦发送消息
          </label>
          <input
            id='live2d-prompt'
            class='live2d-prompt'
            name='prompt'
            required
            autocomplete='off'
            placeholder='和绘梦聊聊…'
          />
          <button class='live2d-send' type='submit' aria-label='发送消息'>
            <svg viewBox='0 0 24 24' aria-hidden='true'>
              <path d='m4 4 17 8-17 8 3-8-3-8Zm3.8 7h7.6L6.7 6.9 7.8 11Zm-1.1 6.1 8.7-4.1H7.8l-1.1 4.1Z' />
            </svg>
          </button>
        </form>
      </section>

      <button
        class='live2d-launcher'
        type='button'
        aria-label='打开 Live2D 助手'
        aria-expanded='true'
      >
        <span class='live2d-launcher-pulse' aria-hidden='true' />
        <svg viewBox='0 0 24 24' aria-hidden='true'>
          <path d='M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-8l-5 4v-4H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 5h10V7H7v2Zm0 4h7v-2H7v2Z' />
        </svg>
      </button>
    </aside>
  )
}

<script>
  import {
    BlogAgentApi,
    parseLive2DEvent,
    type Live2DEvent,
    type Live2DSnapshot,
    type PageContext
  } from './client'
  import { SpeechSegmenter } from './speech-segments'
  import { SpeechMotionController } from './voice-motion'

  interface CoreModel {
    setParameterValueById(id: string, value: number): void
  }

  interface InternalModel {
    coreModel?: CoreModel
    on?(event: string, listener: () => void): void
    off?(event: string, listener: () => void): void
  }

  interface AvatarModel {
    width: number
    height: number
    scale: { set(value: number): void }
    anchor: { set(x: number, y?: number): void }
    position: { set(x: number, y: number): void }
    expression(name: string): Promise<unknown>
    motion(group: string, index: number): Promise<unknown>
    internalModel?: InternalModel
  }

  interface SpeechTurn {
    generation: number
    context: AudioContext
    abortController: AbortController
    queue: string[]
    complete: boolean
    wake?: () => void
    nextStartTime: number
    sampleRate?: number
    lastFinished?: Promise<void>
  }

  const root = document.querySelector<HTMLElement>('[data-live2d-agent]')

  if (root && root.dataset.initialized !== 'true') {
    const agentRoot = root
    agentRoot.dataset.initialized = 'true'
    const stage = agentRoot.querySelector<HTMLElement>('.live2d-stage')!
    const canvas = agentRoot.querySelector<HTMLCanvasElement>('.live2d-canvas')!
    const status = agentRoot.querySelector<HTMLElement>('.live2d-status')!
    const speechElement = agentRoot.querySelector<HTMLElement>('.live2d-speech')!
    const form = agentRoot.querySelector<HTMLFormElement>('.live2d-form')!
    const prompt = agentRoot.querySelector<HTMLInputElement>('.live2d-prompt')!
    const send = agentRoot.querySelector<HTMLButtonElement>('.live2d-send')!
    const launcher = agentRoot.querySelector<HTMLButtonElement>('.live2d-launcher')!
    const actionCard = agentRoot.querySelector<HTMLElement>('[data-live2d-action-card]')!
    const actionTitle = agentRoot.querySelector<HTMLElement>('[data-live2d-action-title]')!
    const actionReason = agentRoot.querySelector<HTMLElement>('[data-live2d-action-reason]')!
    const actionConfirm = agentRoot.querySelector<HTMLButtonElement>(
      '[data-live2d-action-confirm]'
    )!
    const actionDismiss = agentRoot.querySelector<HTMLButtonElement>(
      '[data-live2d-action-dismiss]'
    )!
    const minimize = agentRoot.querySelector<HTMLButtonElement>('.live2d-minimize')!
    const api = new BlogAgentApi(agentRoot.dataset.apiBase || '/agent-api')
    const provider = agentRoot.dataset.provider || 'dashscope'
    const modelId = agentRoot.dataset.model || 'qwen3-max'
    let app: import('pixi.js').Application | undefined
    let avatar: AvatarModel | undefined
    let sessionId = ''
    let eventSource: EventSource | undefined
    let speech = ''
    let speechHideTimer: number | undefined
    let eventQueue = Promise.resolve()
    let pendingAction: Record<string, unknown> | undefined
    let audioContext: AudioContext | undefined
    const speechSources = new Set<AudioBufferSourceNode>()
    let speechAnalyser: AnalyserNode | undefined
    let speechAnimationFrame: number | undefined
    let speechGeneration = 0
    let speechTurn: SpeechTurn | undefined
    const speechSegmenter = new SpeechSegmenter()
    const speechMotion = new SpeechMotionController()
    let mouthLevel = 0
    let avatarSpeaking = false
    let talkMotionGroup: string | undefined
    let idleMotionGroup = 'Idle'

    const allowedRoutePrefixes = [
      '/blog/',
      '/notes/',
      '/pages/',
      '/collection/',
      '/projects/',
      '/search',
      '/about',
      '/links',
      '/academic'
    ]

    function safeInternalHref(value: unknown): string | undefined {
      if (typeof value !== 'string' || !value.startsWith('/') || value.startsWith('//')) return
      try {
        const url = new URL(value, window.location.origin)
        if (url.origin !== window.location.origin) return
        if (
          decodeURIComponent(url.pathname)
            .split('/')
            .some((part) => part === '.' || part === '..')
        )
          return
        if (
          url.pathname !== '/' &&
          !allowedRoutePrefixes.some(
            (prefix) =>
              url.pathname === prefix.replace(/\/$/, '') ||
              url.pathname.startsWith(`${prefix.replace(/\/$/, '')}/`)
          )
        )
          return
        if (url.hash && !/^#[A-Za-z][A-Za-z0-9_-]{0,127}$/.test(url.hash)) return
        return `${url.pathname}${url.search}${url.hash}`
      } catch {
        return
      }
    }

    function hideActionCard() {
      pendingAction = undefined
      actionCard.hidden = true
    }

    function showActionCard(action: Record<string, unknown>) {
      pendingAction = action
      actionTitle.textContent = typeof action.title === 'string' ? action.title : '发现一个页面动作'
      actionReason.textContent = typeof action.reason === 'string' ? action.reason : ''
      actionConfirm.textContent = action.action === 'scroll_to' ? '定位' : '打开'
      actionCard.hidden = false
      setComposerOpen(false)
    }

    function executeAction(action: Record<string, unknown>) {
      if (action.action === 'navigate') {
        const href = safeInternalHref(action.href)
        if (!href) throw new Error('页面地址未通过安全校验')
        window.location.assign(href)
        return
      }
      if (action.action === 'scroll_to') {
        const anchor = action.anchor
        if (typeof anchor !== 'string' || !/^[A-Za-z][A-Za-z0-9_-]{0,127}$/.test(anchor)) {
          throw new Error('页面定位目标未通过安全校验')
        }
        const target = document.getElementById(anchor)
        if (!target) throw new Error('当前页面没有找到这个章节')
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
        target.animate(
          [
            { backgroundColor: 'transparent' },
            {
              backgroundColor: 'color-mix(in srgb, var(--color-primary, #8b5cf6) 18%, transparent)'
            },
            { backgroundColor: 'transparent' }
          ],
          { duration: 1_600, easing: 'ease-out' }
        )
        return
      }
      throw new Error('不支持的页面动作')
    }

    function currentPageContext(): PageContext {
      return {
        href: `${window.location.pathname}${window.location.search}${window.location.hash}`,
        title: document.title.slice(0, 160),
        language: document.documentElement.lang || 'zh'
      }
    }
    let bootstrapPromise: Promise<void> | undefined

    const language = document.documentElement.lang.startsWith('en') ? 'en' : 'zh'
    const copy =
      language === 'en'
        ? {
            ready: 'Ready',
            loading: 'Waking Huimeng…',
            thinking: 'Thinking…',
            placeholder: 'Chat with Huimeng…',
            unavailable: 'Assistant unavailable'
          }
        : {
            ready: '在线',
            loading: '正在唤醒绘梦…',
            thinking: '正在思考…',
            placeholder: '和绘梦聊聊…',
            unavailable: '助手暂时不可用'
          }
    prompt.placeholder = copy.placeholder

    function setState(value: string, label?: string) {
      agentRoot.dataset.state = value
      status.textContent = label || value
    }

    function setSpeech(value: string, visible = value.trim().length > 0, hideAfterMs = 0) {
      if (speechHideTimer) window.clearTimeout(speechHideTimer)
      speechElement.textContent = value
      agentRoot.dataset.speechVisible = String(visible)
      if (visible && hideAfterMs > 0) {
        speechHideTimer = window.setTimeout(() => {
          agentRoot.dataset.speechVisible = 'false'
          speechHideTimer = undefined
        }, hideAfterMs)
      }
    }

    function setComposerOpen(open: boolean) {
      agentRoot.dataset.composerOpen = String(open)
      stage.setAttribute('aria-expanded', String(open))
      if (open) {
        form.setAttribute('aria-hidden', 'false')
        requestAnimationFrame(() => prompt.focus({ preventScroll: true }))
      } else {
        if (
          document.activeElement instanceof HTMLElement &&
          form.contains(document.activeElement)
        ) {
          document.activeElement.blur()
        }
        form.setAttribute('aria-hidden', 'true')
      }
    }

    function fail(error: unknown) {
      const message = error instanceof Error ? error.message : String(error)
      setState('error', copy.unavailable)
      setSpeech(message)
      send.disabled = false
      console.error('[live2d-agent]', error)
    }

    function ensureAudioContext(): AudioContext | undefined {
      if (agentRoot.dataset.ttsEnabled !== 'true') return
      audioContext ??= new AudioContext()
      if (audioContext.state === 'suspended') void audioContext.resume()
      return audioContext
    }

    function stopSpeechAudio() {
      speechGeneration += 1
      speechTurn?.abortController.abort()
      speechTurn?.wake?.()
      speechTurn = undefined
      speechSegmenter.reset()
      if (speechAnimationFrame !== undefined) cancelAnimationFrame(speechAnimationFrame)
      speechAnimationFrame = undefined
      for (const source of speechSources) {
        try {
          source.stop()
        } catch {
          // The source may have already ended.
        }
        source.disconnect()
      }
      speechSources.clear()
      speechAnalyser?.disconnect()
      speechAnalyser = undefined
      avatarSpeaking = false
      agentRoot.dataset.audioActive = 'false'
      mouthLevel = 0
      if (talkMotionGroup) void avatar?.motion(idleMotionGroup, 0)
    }

    function startSpeechTracking(context: AudioContext): AnalyserNode {
      const analyser = context.createAnalyser()
      analyser.fftSize = 512
      analyser.smoothingTimeConstant = 0.35
      analyser.connect(context.destination)
      speechAnalyser = analyser
      avatarSpeaking = true
      agentRoot.dataset.audioActive = 'true'
      setState('speaking')
      if (talkMotionGroup) void avatar?.motion(talkMotionGroup, 0)

      const samples = new Float32Array(analyser.fftSize)
      const updateMouth = () => {
        if (speechAnalyser !== analyser) return
        analyser.getFloatTimeDomainData(samples)
        let energy = 0
        for (const sample of samples) {
          energy += sample * sample
        }
        const rms = Math.sqrt(energy / samples.length)
        const target = Math.min(1, Math.max(0, (rms - 0.015) * 7.5))
        const smoothing = target > mouthLevel ? 0.55 : 0.22
        mouthLevel += (target - mouthLevel) * smoothing
        speechAnimationFrame = requestAnimationFrame(updateMouth)
      }
      updateMouth()
      return analyser
    }

    function sourceFinished(source: AudioBufferSourceNode, signal: AbortSignal): Promise<void> {
      return new Promise((resolve) => {
        const cleanup = () => {
          source.removeEventListener('ended', finish)
          signal?.removeEventListener('abort', onAbort)
        }
        const finish = () => {
          cleanup()
          resolve()
        }
        const onAbort = () => finish()
        if (signal?.aborted) return onAbort()
        source.addEventListener('ended', finish, { once: true })
        signal?.addEventListener('abort', onAbort, { once: true })
      })
    }

    async function streamSpeechSegment(turn: SpeechTurn, text: string) {
      const { context, abortController, generation } = turn
      const response = await api.synthesizeSpeech(sessionId, text, abortController.signal)
      if (generation !== speechGeneration || speechTurn !== turn) return
      if (!response.body) throw new Error('TTS returned no PCM stream')
      const mediaType = response.headers.get('content-type')?.split(';')[0]
      const sampleRate = Number(response.headers.get('x-audio-sample-rate'))
      const channels = Number(response.headers.get('x-audio-channels'))
      const sampleFormat = response.headers.get('x-audio-sample-format')
      if (
        mediaType !== 'audio/pcm' ||
        !Number.isInteger(sampleRate) ||
        sampleRate < 8_000 ||
        sampleRate > 48_000 ||
        channels !== 1 ||
        sampleFormat !== 's16le'
      ) {
        throw new Error('TTS returned an unsupported PCM format')
      }
      if (turn.sampleRate !== undefined && turn.sampleRate !== sampleRate) {
        throw new Error('TTS changed PCM sample rate during a reply')
      }
      turn.sampleRate = sampleRate

      const reader = response.body.getReader()
      let trailingByte: number | undefined
      let pendingSamples = new Float32Array(0)
      let playbackStarted = speechAnalyser !== undefined
      let segmentScheduled = false
      const batchFrames = Math.round(sampleRate * 0.12)
      const startupFrames = Math.round(sampleRate * 0.18)

      const schedule = (samples: Float32Array) => {
        segmentScheduled = true
        const analyser = speechAnalyser ?? startSpeechTracking(context)
        const buffer = context.createBuffer(1, samples.length, sampleRate)
        buffer.getChannelData(0).set(samples)
        const source = context.createBufferSource()
        source.buffer = buffer
        source.connect(analyser)
        speechSources.add(source)
        source.addEventListener(
          'ended',
          () => {
            speechSources.delete(source)
            source.disconnect()
          },
          { once: true }
        )
        turn.lastFinished = sourceFinished(source, abortController.signal)
        const startAt = Math.max(turn.nextStartTime, context.currentTime + 0.015)
        source.start(startAt)
        turn.nextStartTime = startAt + buffer.duration
      }

      const flushReadySamples = (finished = false) => {
        if (!playbackStarted && (pendingSamples.length >= startupFrames || finished)) {
          if (pendingSamples.length > 0) schedule(pendingSamples)
          pendingSamples = new Float32Array(0)
          playbackStarted = true
        }
        while (playbackStarted && pendingSamples.length >= batchFrames) {
          schedule(pendingSamples.slice(0, batchFrames))
          pendingSamples = pendingSamples.slice(batchFrames)
        }
        if (finished && pendingSamples.length > 0) {
          schedule(pendingSamples)
          pendingSamples = new Float32Array(0)
        }
      }

      while (true) {
        const { done, value } = await reader.read()
        if (generation !== speechGeneration || speechTurn !== turn) {
          await reader.cancel()
          return
        }
        if (done) break

        let bytes = value
        if (trailingByte !== undefined) {
          const joined = new Uint8Array(value.byteLength + 1)
          joined[0] = trailingByte
          joined.set(value, 1)
          bytes = joined
          trailingByte = undefined
        }
        if (bytes.byteLength % 2 === 1) {
          trailingByte = bytes[bytes.byteLength - 1]
          bytes = bytes.subarray(0, bytes.byteLength - 1)
        }
        if (bytes.byteLength === 0) continue

        const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength)
        const samples = new Float32Array(bytes.byteLength / 2)
        for (let index = 0; index < samples.length; index += 1) {
          samples[index] = view.getInt16(index * 2, true) / 32_768
        }
        const joined = new Float32Array(pendingSamples.length + samples.length)
        joined.set(pendingSamples)
        joined.set(samples, pendingSamples.length)
        pendingSamples = joined
        flushReadySamples()
      }
      if (trailingByte !== undefined) throw new Error('TTS returned incomplete PCM data')
      flushReadySamples(true)
      if (!segmentScheduled) throw new Error('TTS returned no audio')
    }

    async function closeSpeechTurn(turn: SpeechTurn) {
      if (turn.lastFinished) await turn.lastFinished
      if (turn.generation !== speechGeneration || speechTurn !== turn) return

      avatarSpeaking = false
      agentRoot.dataset.audioActive = 'false'
      const deadline = performance.now() + 1_200
      while (
        (mouthLevel > 0.01 || (!talkMotionGroup && !speechMotion.settled)) &&
        performance.now() < deadline
      ) {
        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()))
        if (turn.generation !== speechGeneration || speechTurn !== turn) return
      }

      if (talkMotionGroup) void avatar?.motion(idleMotionGroup, 0)
      const coreModel = avatar?.internalModel?.coreModel
      if (coreModel && !talkMotionGroup && !speechMotion.settled) speechMotion.reset(coreModel)
      if (speechAnimationFrame !== undefined) cancelAnimationFrame(speechAnimationFrame)
      speechAnimationFrame = undefined
      speechAnalyser?.disconnect()
      speechAnalyser = undefined
      mouthLevel = 0
      speechTurn = undefined
      setState('idle', copy.ready)
    }

    async function runSpeechTurn(turn: SpeechTurn) {
      try {
        while (turn.generation === speechGeneration && speechTurn === turn) {
          const segment = turn.queue.shift()
          if (segment) {
            await streamSpeechSegment(turn, segment)
            continue
          }
          if (turn.complete) break
          await new Promise<void>((resolve) => {
            turn.wake = resolve
          })
          turn.wake = undefined
        }
        await closeSpeechTurn(turn)
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return
        if (turn.generation !== speechGeneration || speechTurn !== turn) return
        stopSpeechAudio()
        setState('idle', copy.ready)
        console.warn('[live2d-agent] TTS unavailable', error)
      }
    }

    function enqueueSpeechSegment(text: string) {
      const context = ensureAudioContext()
      const segment = text.trim()
      if (!context || !segment) return
      let turn = speechTurn
      if (!turn) {
        const abortController = new AbortController()
        turn = {
          generation: speechGeneration,
          context,
          abortController,
          queue: [],
          complete: false,
          nextStartTime: context.currentTime + 0.04
        }
        speechTurn = turn
        void runSpeechTurn(turn)
      }
      turn.queue.push(segment)
      turn.wake?.()
    }

    function completeSpeechTurn() {
      if (!speechTurn) {
        setState('idle', copy.ready)
        return
      }
      speechTurn.complete = true
      speechTurn.wake?.()
    }

    const applyVoiceParameters = () => {
      const coreModel = avatar?.internalModel?.coreModel
      if (!coreModel) return
      coreModel.setParameterValueById('ParamMouthOpenY', mouthLevel)
      if (!talkMotionGroup) {
        speechMotion.update(coreModel, {
          timeSeconds: performance.now() / 1_000,
          energy: mouthLevel,
          speaking: avatarSpeaking
        })
      }
    }

    function loadScript(source: string): Promise<void> {
      const coreWindow = window as typeof window & { Live2DCubismCore?: unknown }
      if (coreWindow.Live2DCubismCore) return Promise.resolve()
      const fallback = agentRoot.dataset.coreFallbackUrl
      const candidates = fallback && fallback !== source ? [source, fallback] : [source]
      let lastError: Error | undefined
      return candidates
        .reduce<Promise<void>>(
          (promise, candidate) =>
            promise.catch(async (error: unknown) => {
              lastError = error instanceof Error ? error : new Error(String(error))
              await new Promise<void>((resolve, reject) => {
                const script = document.createElement('script')
                script.src = candidate
                script.crossOrigin = 'anonymous'
                script.onload = () => resolve()
                script.onerror = () => {
                  script.remove()
                  reject(new Error(`Cubism Core 加载失败: ${candidate}`))
                }
                document.head.append(script)
              })
            }),
          Promise.reject(new Error(`Cubism Core 加载失败: ${source}`))
        )
        .catch((error: unknown) => {
          throw lastError || (error instanceof Error ? error : new Error(String(error)))
        })
    }

    function fitAvatar() {
      if (!avatar || !stage.clientWidth || !stage.clientHeight) return
      avatar.scale.set(1)
      const scale = Math.min(stage.clientWidth / avatar.width, stage.clientHeight / avatar.height)
      avatar.scale.set(scale * 1.02)
      avatar.anchor.set(0.5, 0.5)
      avatar.position.set(stage.clientWidth / 2, stage.clientHeight / 2 + 12)
    }

    async function applySnapshot(snapshot: Live2DSnapshot) {
      setState(snapshot.state, snapshot.state === 'idle' ? copy.ready : undefined)
      speech = snapshot.speech_text
      setSpeech(speech, snapshot.state !== 'idle')
      if (snapshot.expression) {
        agentRoot.dataset.expression = snapshot.expression
        await avatar?.expression(snapshot.expression)
      } else delete agentRoot.dataset.expression
      if (snapshot.motion_group) {
        agentRoot.dataset.motionGroup = snapshot.motion_group
        agentRoot.dataset.motionIndex = String(snapshot.motion_index || 0)
        await avatar?.motion(snapshot.motion_group, snapshot.motion_index || 0)
      } else {
        delete agentRoot.dataset.motionGroup
        delete agentRoot.dataset.motionIndex
      }
      for (const [id, value] of Object.entries(snapshot.parameters)) {
        avatar?.internalModel?.coreModel?.setParameterValueById(id, value)
      }
    }

    async function applyEvent(event: Live2DEvent) {
      const data = event.data
      if (event.type === 'live2d.state.changed' && typeof data.state === 'string') {
        setState(data.state)
      }
      if (event.type === 'live2d.speech.delta' && typeof data.delta === 'string') {
        speech += data.delta
        setSpeech(speech)
        setState('speaking')
        for (const segment of speechSegmenter.push(data.delta)) enqueueSpeechSegment(segment)
      }
      if (event.type === 'live2d.speech.completed') {
        speech = typeof data.text === 'string' ? data.text : speech
        setSpeech(speech, Boolean(speech), 12_000)
        for (const segment of speechSegmenter.finish(speech)) enqueueSpeechSegment(segment)
        completeSpeechTurn()
        send.disabled = false
      }
      if (event.type === 'live2d.error') {
        stopSpeechAudio()
        throw new Error(typeof data.message === 'string' ? data.message : copy.unavailable)
      }
      if (event.type === 'live2d.web.action.intent') {
        showActionCard(data)
        return
      }
      if (event.type !== 'live2d.command') return
      if (typeof data.expression === 'string') {
        agentRoot.dataset.expression = data.expression
        await avatar?.expression(data.expression)
      }
      if (typeof data.motion_group === 'string') {
        agentRoot.dataset.motionGroup = data.motion_group
        agentRoot.dataset.motionIndex = String(
          typeof data.motion_index === 'number' ? data.motion_index : 0
        )
        await avatar?.motion(
          data.motion_group,
          typeof data.motion_index === 'number' ? data.motion_index : 0
        )
      }
      if (data.parameters && typeof data.parameters === 'object') {
        for (const [id, value] of Object.entries(data.parameters)) {
          if (typeof value === 'number') {
            avatar?.internalModel?.coreModel?.setParameterValueById(id, value)
          }
        }
      }
    }

    function connectEvents(cursor: number) {
      eventSource?.close()
      eventSource = api.events(sessionId, cursor)
      for (const type of [
        'live2d.state.changed',
        'live2d.command',
        'live2d.speech.delta',
        'live2d.speech.completed',
        'live2d.error',
        'live2d.web.action.intent'
      ]) {
        eventSource.addEventListener(type, (raw) => {
          eventQueue = eventQueue
            .then(() =>
              applyEvent(parseLive2DEvent(JSON.parse((raw as MessageEvent).data)) as Live2DEvent)
            )
            .catch(fail)
        })
      }
    }

    async function bootstrap() {
      setSpeech(copy.loading)
      await loadScript(agentRoot.dataset.coreUrl || '/live2dcubismcore.min.js')
      const PIXI = await import('pixi.js')
      ;(window as typeof window & { PIXI: typeof PIXI }).PIXI = PIXI
      const { Live2DModel } = await import('pixi-live2d-display/cubism4')
      Live2DModel.registerTicker(PIXI.Ticker)

      const [modelInfo, session] = await Promise.all([
        api.model(),
        api.ensureSession(window.localStorage)
      ])
      sessionId = session.id
      agentRoot.dataset.sessionId = sessionId
      app = new PIXI.Application({
        view: canvas,
        resizeTo: stage,
        backgroundAlpha: 0,
        antialias: true,
        autoDensity: true
      })
      avatar = (await Live2DModel.from(api.url(modelInfo.manifest_url), {
        autoInteract: true,
        idleMotionGroup: 'Idle'
      })) as AvatarModel
      talkMotionGroup = Object.keys(modelInfo.motion_groups).find(
        (group) => group.toLowerCase() === 'talk'
      )
      idleMotionGroup =
        Object.keys(modelInfo.motion_groups).find((group) => group.toLowerCase() === 'idle') ||
        'Idle'
      avatar.internalModel?.on?.('afterMotionUpdate', applyVoiceParameters)
      app.stage.addChild(avatar as unknown as import('pixi.js').DisplayObject)
      fitAvatar()
      window.addEventListener('resize', fitAvatar)

      const snapshot = await api.snapshot(sessionId)
      await applySnapshot(snapshot)
      connectEvents(snapshot.sequence)
      if (!speech) {
        setSpeech(snapshot.state === 'idle' ? '' : status.textContent || copy.loading)
      }
      if (agentRoot.dataset.minimized === 'true') app.stop()
    }

    function ensureBootstrap() {
      bootstrapPromise ??= bootstrap()
      bootstrapPromise.catch(fail)
    }

    function setMinimized(minimized: boolean) {
      if (minimized) setComposerOpen(false)
      agentRoot.dataset.minimized = String(minimized)
      launcher.setAttribute('aria-expanded', String(!minimized))
      launcher.setAttribute('aria-label', minimized ? '打开 Live2D 助手' : '收起 Live2D 助手')
      if (minimized) app?.stop()
      else {
        app?.start()
        requestAnimationFrame(fitAvatar)
      }
    }

    launcher.addEventListener('click', () => {
      const willOpen = agentRoot.dataset.minimized === 'true'
      setMinimized(!willOpen)
      if (willOpen && !app) ensureBootstrap()
    })
    minimize.addEventListener('click', () => setMinimized(true))
    stage.addEventListener('click', () => setComposerOpen(true))
    stage.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return
      event.preventDefault()
      setComposerOpen(true)
    })
    prompt.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.isComposing) return
      event.preventDefault()
      form.requestSubmit()
    })
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      const text = prompt.value.trim()
      if (!text || !sessionId) return
      send.disabled = true
      stopSpeechAudio()
      ensureAudioContext()
      speech = ''
      setSpeech(copy.thinking)
      setState('thinking')
      prompt.value = ''
      setComposerOpen(false)
      try {
        await api.run(sessionId, text, provider, modelId, currentPageContext())
      } catch (error) {
        fail(error)
      }
    })
    actionConfirm.addEventListener('click', () => {
      if (!pendingAction) return
      try {
        executeAction(pendingAction)
        hideActionCard()
      } catch (error) {
        hideActionCard()
        fail(error)
      }
    })
    actionDismiss.addEventListener('click', hideActionCard)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) app?.stop()
      else if (agentRoot.dataset.minimized !== 'true') app?.start()
    })
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !agentRoot.contains(event.target)) setComposerOpen(false)
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setComposerOpen(false)
    })
    window.addEventListener('beforeunload', () => {
      eventSource?.close()
      stopSpeechAudio()
      avatar?.internalModel?.off?.('afterMotionUpdate', applyVoiceParameters)
      void audioContext?.close()
    })

    if (window.matchMedia('(max-width: 520px)').matches) setMinimized(true)
    else ensureBootstrap()
  }
</script>

