---
import type { SiteMeta } from '@/types'

import PageLayout from '@/layouts/BaseLayout.astro'
import { BackToTop } from '@/components/pages'
import { cn } from '@/utils'
import { integ } from '@/site-config'

import '@/assets/styles/reader.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  back?: string
  readingLayout?: boolean
}

const { meta, highlightColor, readingLayout = false, ...props } = Astro.props
---

<PageLayout {meta} {highlightColor} {...props}>
  <main
    class:list={['mt-6 items-start gap-x-10 md:flex', { 'reader-layout': readingLayout }]}
    data-reader-layout={readingLayout ? '' : undefined}
  >
    {/* Sidebar */}
    {
      readingLayout ? (
        <details class='reader-navigation' data-reader-navigation>
          <summary aria-controls='sidebar'>
            <svg
              aria-hidden='true'
              width='18'
              height='18'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.6'
            >
              <path d='M4 6h16M4 12h16M4 18h16' />
            </svg>
            <span>目录与导航</span>
          </summary>
          <aside id='sidebar' class='reader-navigation-panel' aria-label='文章目录与知识地图'>
            <slot name='sidebar' />
          </aside>
        </details>
      ) : (
        <aside
          class='animate top-24 min-w-48 basis-60 overflow-y-scroll max-md:hidden md:sticky md:order-2 lg:shrink-0'
          style='height:calc(100vh - 8rem);'
          id='sidebar'
        >
          <slot name='sidebar' />
        </aside>
      )
    }

    <article class='min-w-0 grow'>
      {/* Content header */}
      <div id='content-header' class='animate'>
        <slot name='header' />
      </div>

      {/* Content */}
      <div
        id='content'
        class={cn('max-w-none animate mt-8 md:min-w-[45ch]', integ.typography.class)}
      >
        <slot />
      </div>
    </article>
  </main>

  <div class:list={['mt-6 items-start gap-x-10 md:flex', { 'reader-bottom': readingLayout }]}>
    {/* Bottom */}
    <div class='mt-8 flex-1 text-muted-foreground md:min-w-[50ch]'>
      <slot name='bottom' />
    </div>
    <div class='min-w-48 basis-60'>
      <slot name='bottom-sidebar' />
    </div>
  </div>

  <BackToTop header='content-header' content='content' />
</PageLayout>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>('[data-reader-navigation]')
    .forEach((navigation) => {
      const summary = navigation.querySelector('summary')

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !navigation.open) return
        navigation.open = false
        summary?.focus()
      })

      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !navigation.contains(event.target)) {
          navigation.open = false
        }
      })

      navigation.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a[href^="#"]')) {
          navigation.open = false
        }
      })
    })

  const copyIcon = `
    <svg aria-hidden="true" class="size-5">
      <use href="/icons/code.svg#mingcute-clipboard-line"></use>
    </svg>
  `
  const copiedIcon = `
    <svg aria-hidden="true" class="size-5">
      <use href="/icons/code.svg#mingcute-file-check-line"></use>
    </svg>
  `

  async function copyText(text: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text)
        return
      } catch {
        // Fall back for local or restricted browser contexts.
      }
    }

    const textarea = document.createElement('textarea')
    textarea.value = text
    textarea.setAttribute('readonly', '')
    textarea.style.position = 'fixed'
    textarea.style.opacity = '0'
    document.body.appendChild(textarea)
    textarea.select()
    document.execCommand('copy')
    textarea.remove()
  }

  function initCodeCopyButtons() {
    document.querySelectorAll<HTMLElement>('#content pre').forEach((pre) => {
      if (pre.querySelector(':scope > .copy, :scope > .code-copy-button')) return

      const code = pre.querySelector('code')
      if (!code?.textContent?.trim()) return

      pre.classList.add('code-copy-ready')

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'code-copy-button'
      button.title = 'Copy code'
      button.setAttribute('aria-label', 'Copy code')
      button.innerHTML = copyIcon

      button.addEventListener('click', async () => {
        await copyText(code.textContent || '')
        button.classList.add('copied')
        button.title = 'Copied'
        button.setAttribute('aria-label', 'Copied')
        button.innerHTML = copiedIcon

        window.setTimeout(() => {
          button.classList.remove('copied')
          button.title = 'Copy code'
          button.setAttribute('aria-label', 'Copy code')
          button.innerHTML = copyIcon
        }, 2000)
      })

      pre.appendChild(button)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCodeCopyButtons, { once: true })
  } else {
    initCodeCopyButtons()
  }
</script>

<style>
  :global(#content pre.code-copy-ready) {
    position: relative;
  }

  :global(#content pre.code-copy-ready:hover .code-copy-button),
  :global(#content pre.code-copy-ready:focus-within .code-copy-button),
  :global(#content .code-copy-button.copied) {
    opacity: 1;
  }

  :global(#content .code-copy-button) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: hsl(var(--background) / 0.88);
    color: hsl(var(--muted-foreground));
    opacity: 0.72;
    backdrop-filter: blur(8px);
    transition:
      opacity 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  :global(#content .code-copy-button:hover),
  :global(#content .code-copy-button:focus-visible),
  :global(#content .code-copy-button.copied) {
    border-color: hsl(var(--foreground) / 0.25);
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    outline: none;
  }
</style>
