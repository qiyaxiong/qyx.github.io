---
import { mangaAssetBase, mangaCatalog, mangaPages } from '@/lib/manga'

import MangaReader from '@/components/manga/MangaReader.astro'

export const prerender = true

export function getStaticPaths() {
  return mangaCatalog.chapters
    .filter((chapter) => mangaAssetBase && mangaPages[String(chapter.id)]?.length)
    .map((chapter) => ({
      params: { chapter: String(chapter.id) },
      props: { chapterId: chapter.id }
    }))
}

const { chapterId } = Astro.props
---

<MangaReader {chapterId} />
