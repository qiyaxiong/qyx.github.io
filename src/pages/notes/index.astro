---
import type { MarkdownHeading } from 'astro'
import { getNotionPageContent } from '@/lib/notion'
import { buildNoteTree, getNotesCollection } from '@/server'

import NotesView from '@/components/pages/NotesView.astro'
import { getDescriptionFromMarkdown, renderNotionMarkdown } from '@/utils/notion-markdown'

export const prerender = true

const notes = await getNotesCollection()
const root = buildNoteTree(notes, 'Notes')
const treeNodes = root.children

let html: string | undefined
let headings: MarkdownHeading[] = []
let description = '按主题浏览学习笔记、推导、实验记录与工程手册。'

if (root.page) {
  const markdown =
    root.page.source === 'local'
      ? root.page.markdown || ''
      : await getNotionPageContent(root.page.sourcePageId!)
  const rendered = await renderNotionMarkdown(markdown)
  html = rendered.html
  headings = rendered.headings
  description = root.page.description || getDescriptionFromMarkdown(markdown, root.page.title)
}

const title = root.page?.title || 'Notes'
const breadcrumbs = [{ title, href: '/notes' }]
---

<NotesView
  title={title}
  {description}
  language='zh'
  basePath='/notes'
  currentPath=''
  rootTitle='知识地图'
  {treeNodes}
  {breadcrumbs}
  childNodes={root.children}
  {headings}
  {html}
/>
