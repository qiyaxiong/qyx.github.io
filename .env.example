NOTION_API_KEY=""

NOTION_REGISTRY_DATABASE_ID=""

# Optional: GitHub personal access token for the homepage contribution calendar.
# Without this, the site shows public contributions only.
GITHUB_TOKEN=""

# Optional: Notion webhook -> rebuild blog after Notion content changes.
# 1. Create a Notion webhook subscription pointing to /api/notion-sync.
# 2. Paste Notion's verification token here after subscription verification.
NOTION_WEBHOOK_VERIFICATION_TOKEN=""

# Vercel Deploy Hook URL, or any build hook URL that accepts POST.
VERCEL_DEPLOY_HOOK_URL=""

# Live2D Agent widget. The public base stays same-origin; private values are server-only.
PUBLIC_LIVE2D_ENABLED="false"
PUBLIC_PI_AGENT_API_BASE="/agent-api"
PUBLIC_PI_AGENT_PROVIDER="dashscope"
PUBLIC_PI_AGENT_MODEL="qwen-plus"
PUBLIC_LIVE2D_CUBISM_CORE_URL="/live2dcubismcore.min.js"
# If the licensed Core file is not copied into public/, the local dev client falls back to this URL.
PUBLIC_LIVE2D_CUBISM_CORE_FALLBACK_URL="https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js"
PI_AGENT_SERVER_URL="http://127.0.0.1:8765"
PI_AGENT_ADMIN_TOKEN=""
PI_AGENT_BFF_SECRET=""
PI_AGENT_CATALOG_TOKEN=""
PI_AGENT_GUEST_PROVIDER="dashscope"
PI_AGENT_GUEST_MODEL="qwen-plus"
